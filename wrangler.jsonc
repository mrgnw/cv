{
	"name": "morgan-cv",
	"compatibility_date": "2025-10-31",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./.svelte-kit/cloudflare/_worker.js",
	"assets": {
		"directory": "./.svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"workers_dev": false,
	"routes": [
		{ "pattern": "cv.morganwill.com/*", "zone_name": "morganwill.com" }
	]
}
